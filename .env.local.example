# After5 environment variables.
# Copy to .env.local and fill in. NEVER commit .env.local.

# ── Supabase (cloud) ───────────────────────────────────────────
# Get these from: Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://ufufmcpnysvwtutpbian.supabase.co

# Publishable key (formerly "anon" key). Safe to ship to clients.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER expose to the client. NEVER paste in chat.
# Used by Edge Functions + admin scripts.
SUPABASE_SECRET_KEY=

# Project ref (used by CLI + MCP)
SUPABASE_PROJECT_REF=ufufmcpnysvwtutpbian

# ── Anthropic (LLM) ────────────────────────────────────────────
# Server-only. Used inside Edge Functions for itinerary writing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@after5.app

# ── Analytics (PostHog) ────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# ── Twilio (phone OTP via Supabase Auth SMS) — server-only ─────
# From Twilio Console → Account Info. Use TEST creds for local dev.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
# API Key (preferred over primary auth token; secret shown once at creation):
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# A sender is required before live SMS sends — set ONE of these:
TWILIO_MESSAGE_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# ── Persona (identity + 18+ age verification) — server-only ────
# Sandbox now; swap to Production keys when the trial is approved.
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=
